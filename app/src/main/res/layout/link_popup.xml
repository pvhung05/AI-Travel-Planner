<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:paddingTop="20dp"
    android:paddingBottom="0dp">

    <!-- Nền mờ chỉ phủ phần dưới -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="0dp"
        android:background="@drawable/bg_search_orange"
        android:orientation="vertical">

        <!-- Ô popup nằm ở dưới cùng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_margin="16dp"
            android:background="@drawable/edittext_orange_border"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <EditText
                android:id="@+id/editLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:focusable="false"
                android:text="https://mytravelapp.com/invite/abc123"
                android:textColor="@color/black"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/btnCopy"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:srcCompat="@drawable/icon_copy"
                app:tint="@color/black" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
