<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#666666">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="#FFFFFF">

        <!-- Next (ImageButton) -->

        <!-- Title -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/btn_back"
            android:contentDescription="@string/back"
            android:padding="8dp"

            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:translationY="20px"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="328dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_back"
            android:contentDescription="@string/next"
            android:padding="8dp"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_next"
            app:tint="#6B6B6B" />

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add itinerary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#111111"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/dayTabs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <!-- Clear current day -->

        <!-- Day tabs (dynamic) -->

        <ImageButton
            android:id="@+id/btnClearDay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="80dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/delete"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@android:drawable/ic_menu_delete"
            app:tint="#D32F2F" />

        <LinearLayout
            android:id="@+id/dayTabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnNext"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerActivities"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/dayTabs"
            app:layout_constraintBottom_toTopOf="@+id/actionBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:listitem="@layout/item_activity" />

        <!-- Action bar: Delete selected + Add activity -->
        <LinearLayout
            android:id="@+id/actionBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btnSavePlan">

            <Button
                android:id="@+id/btnDeleteSelected"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Delete selected"
                android:textColor="#D32F2F"
                android:background="@drawable/bg_button_disabled"
                android:enabled="false" />

            <Space
                android:layout_width="12dp"
                android:layout_height="0dp" />

            <Button
                android:id="@+id/btnAddActivity"
                android:layout_width="0dp"
                android:layout_height="48dp"
                app:backgroundTint="@null"
                android:layout_weight="1"
                android:text="Add activity"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_cta_gradient" />
        </LinearLayout>

        <!-- Save -->
        <Button
            android:id="@+id/btnSavePlan"
            android:layout_width="0dp"
            android:layout_height="52dp"
            app:backgroundTint="@null"
            android:text="Save Plan"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_cta_gradient"
            android:includeFontPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
