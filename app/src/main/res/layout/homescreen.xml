<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">

    <!-- Header -->

    <!-- Search Bar -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="319dp"
            android:layout_height="73dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, Jojo 👋"
                android:textColor="@android:color/black"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Explore the world"
                android:textColor="#999999"
                android:textSize="16sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgProfile"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/circle_bg"
            android:scaleType="centerCrop"
            android:src="@drawable/vacation" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="387dp"
        android:layout_height="75dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/search_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="325dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Search Places"
            android:padding="0dp"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/imgFilter"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:src="@drawable/ai" />
    </LinearLayout>

    <!-- Popular Places Header -->
    <LinearLayout
        android:id="@+id/popularHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/searchBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Popular Places"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

<!--        <TextView-->
<!--            android:id="@+id/tvViewAll"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="View all"-->
<!--            android:textSize="14sp"-->
<!--            android:textColor="#FF5722"/>-->
    </LinearLayout>

    <!-- Tabs -->
    <LinearLayout
        android:id="@+id/tabsLayout"
        android:layout_width="454dp"
        android:layout_height="108dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/popularHeader">

        <Button
            android:id="@+id/btnMostViewed"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_outline"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Most Viewed"
            android:textColor="@android:color/white"/>



        <Space
            android:layout_width="1dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnNearby"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Nearby"
            android:textColor="#888888" />

        <Space
            android:layout_width="1dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btnLatest"
            android:layout_width="120dp"
            android:layout_height="55dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_outline"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="Latest"
            android:textColor="#888888" />
    </LinearLayout>

    <!-- Horizontal List of Places -->

    <!-- Bottom Navigation -->


    <!-- Two Buttons in the middle -->
    <!-- Two compact card-like buttons (side by side) -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPlaces"
        android:layout_width="413dp"
        android:layout_height="405dp"
        android:padding="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabsLayout"
        app:layout_constraintVertical_bias="0.0" />

    <LinearLayout
        android:id="@+id/middleButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginVertical="8dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/recyclerPlaces"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left button: Traveling -->
        <LinearLayout
            android:id="@+id/btnTravel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/btn_orange_outline"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="8dp"
                android:src="@drawable/ic_bag" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTravelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Travel"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtTravelSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="from ₹2999"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />
            </LinearLayout>


        </LinearLayout>

        <!-- Right button: Hotel -->
        <LinearLayout
            android:id="@+id/btnHotel"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/btn_orange_outline"
            android:padding="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="8dp"
                android:src="@drawable/ic_hotel" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHotelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hotels"
                    android:textColor="#111111"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtHotelSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="from ₹1999 / night"
                    android:textColor="#8A8A8A"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>



    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        android:background="?attr/colorSurface"
        app:itemIconSize="24dp"

        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        />


</androidx.constraintlayout.widget.ConstraintLayout>
