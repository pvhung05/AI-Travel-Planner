<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog"
    android:gravity="center_vertical">

    <!-- Tiêu đề -->

    <!-- Ô nhập thời gian -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="Add activity"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Time (e.g. 09:00)"
        app:startIconDrawable="@android:drawable/ic_menu_recent_history"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="#E0E0E0"
        app:boxBackgroundColor="#FAFAFA"
        android:layout_marginHorizontal="25dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="time" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ô nhập tiêu đề -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Activity name"
        app:startIconDrawable="@android:drawable/ic_menu_edit"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#E0E0E0"
        app:boxBackgroundColor="#FAFAFA"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ô nhập loại hoạt động -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Classification (cuisine, culture, nature...)"
        app:startIconDrawable="@android:drawable/ic_menu_sort_by_size"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#E0E0E0"
        app:boxBackgroundColor="#FAFAFA"
        android:layout_marginHorizontal="25dp"
        android:layout_marginTop="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nút hành động -->
    <LinearLayout
        android:layout_width="297dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_orange_outline"
            android:text="Cancel"
            android:textColor="@android:color/darker_gray"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="99dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_signin_gradient"
            android:text="Save"
            android:textColor="@android:color/white"
            app:backgroundTint="@null" />
    </LinearLayout>
</LinearLayout>
