<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.ai_travel_planner">

    <!-- QUAN TRỌNG: Cho phép truy cập mạng -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Quan trong: Cho phep doc file anh trong thu vien -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Màn hình khởi động -->
        <activity android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Các màn hình còn lại -->
        <activity android:name=".ui.home.home.HomeScreen" />

        <activity android:name=".ui.home.login.StartScreen" />
        <activity android:name=".ui.home.login.LoginScreen" />
        <activity android:name=".ui.home.login.SigninScreen" />

        <activity android:name=".ui.home.activity.AddItineraryScreen" />

        <activity android:name=".ui.home.booking.BusBookingScreen" />
        <activity android:name=".ui.home.booking.HotelBookingScreen" />
        <activity android:name=".ui.home.booking.PlaneBookingScreen" />

        <activity android:name=".ui.home.booking.PlaceSearchActivity"/>
        <activity android:name=".ui.home.booking.HotelSearchResultScreen" android:exported="false" />
        <activity android:name=".ui.home.describe.DescribeScreen" />
        <activity android:name=".ui.home.booking.HotelDetailScreen" />
        <activity android:name=".ui.home.favorite.FavoriteScreen" />

        <activity android:name=".ui.home.friend.FriendScreen" />

        <activity android:name=".ui.home.plan.CalendarScreen" />
        <activity android:name=".ui.home.plan.GuideScreen" />
        <activity android:name=".ui.home.plan.PlanScreen" />
        <activity android:name=".ui.home.plan.WeatherScreen" />
        <activity
            android:name=".ui.home.itinerary.ItineraryScreen"
            android:exported="false" />
        <activity android:name=".ui.home.profile.ProfileScreen" />

    </application>

</manifest>
